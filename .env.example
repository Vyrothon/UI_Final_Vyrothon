# =============================================================================
# ClearClaim — copy to .env.local and fill in values
# Never commit .env.local or real secrets.
# =============================================================================

# Public site URL (sitemap, metadata, canonical)
NEXT_PUBLIC_SITE_URL=https://clearclaim.ai

# Separate web app origin (optional). When set, site-config helpers use it for /login and /signup paths.
# NEXT_PUBLIC_APP_URL=https://app.clearclaim.ai


# -----------------------------------------------------------------------------
# Groq (OpenAI-compatible API — fast inference)
# https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# Fast default: good latency for audits + JSON. Change if you prefer larger model.
# Examples: llama-3.1-8b-instant, llama-3.3-70b-versatile, openai/gpt-oss-120b
GROQ_MODEL=llama-3.1-8b-instant

# Optional: separate model for heavier reasoning (leave empty to use GROQ_MODEL)
# GROQ_MODEL_REASONING=llama-3.3-70b-versatile

# Base URL (only if Groq changes endpoint; default works with groq-sdk)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# SerpAPI — web / Google search for rate lookups, citations, grounding
# https://serpapi.com/manage-api-key
# -----------------------------------------------------------------------------
SERPAPI_API_KEY=

# Optional: Google search engine is default; override if needed
# SERPAPI_ENGINE=google

# -----------------------------------------------------------------------------
# Supabase — auth, Postgres, Storage, pgvector
# https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Legacy anon key (JWT "eyJ...") — or use publishable key below instead
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New dashboard: Publishable key (sb_publishable_...) — used if ANON_KEY is empty
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: bypass RLS for admin jobs, seeds, webhooks — never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection (migrations, Prisma, drizzle)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# OpenAI-compatible model endpoint for audit generation
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
FREE_TIER_SCAN_LIMIT=1
CLEARCLAIM_MOCK_MODE=false

# -----------------------------------------------------------------------------
# Frontend/site URL config (replace when deploying)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: override navbar Login / Sign up targets (defaults: /login, /signup). Use full URL for external app.
# NEXT_PUBLIC_APP_LOGIN_URL=/login
# NEXT_PUBLIC_APP_SIGNUP_URL=/signup
